{
  "name": "cas-fieldops",
  "version": "0.3.1",
  "description": "Open-source construction material and manpower tracking",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
